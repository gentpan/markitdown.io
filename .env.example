# MarkItDown API 配置
APP_NAME=MarkItDown Web
DEBUG=false
HOST=0.0.0.0
PORT=8000

# 文件上传限制 (MB)
MAX_FILE_SIZE=50
UPLOAD_DIR=uploads
OUTPUT_DIR=outputs

# 管理后台 Basic Auth；不设置 ADMIN_PASSWORD 时 /admin 会被禁用
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 生产环境建议设置为你的真实域名，例如 https://makeitdown.io
CORS_ORIGINS=*

# ---- MarkItDown 自动更新 ----
# 是否启用定时检查（默认 true）
UPDATE_CHECK_ENABLED=true
# 检查间隔（小时），默认 168 = 每周一次
UPDATE_CHECK_INTERVAL_HOURS=168
# 发现新版本后是否自动安装并重启（默认 false，仅检查+记录）
AUTO_UPDATE=false
# pip 安装规格
MARKITDOWN_PACKAGE_SPEC=markitdown[all]
# 可选：提高 GitHub API 限额
# GITHUB_TOKEN=

# API 限流（付费 API 用）
RATE_LIMIT_FREE=10/hour
RATE_LIMIT_PAID=1000/hour

# 可选：OpenAI API Key（用于图片 OCR / 描述）
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
